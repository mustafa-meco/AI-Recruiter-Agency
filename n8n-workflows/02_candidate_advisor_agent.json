{
    "name": "AI Recruiter - Candidate Advisor (Self-Service)",
    "nodes": [
        {
            "parameters": {
                "content": "## 🤖 Candidate Advisor — Self-Service\n\nCandidates upload resume and get:\n- Profile extraction\n- Career strengths & skill gaps\n- CV improvement tips\n- Optional email delivery\n\n**POST** `/webhook/candidate-advisor`\n```json\n{ \"resume_text\": \"...\", \"candidate_email\": \"optional\" }\n```",
                "height": 300,
                "width": 380,
                "color": 5
            },
            "id": "sticky-overview",
            "name": "Overview",
            "type": "n8n-nodes-base.stickyNote",
            "typeVersion": 1,
            "position": [
                0,
                0
            ]
        },
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "candidate-advisor",
                "responseMode": "responseNode",
                "authentication": "headerAuth"
            },
            "id": "webhook-trigger",
            "name": "Candidate Advisor Webhook",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 2,
            "position": [
                500,
                380
            ],
            "webhookId": "candidate-advisor-webhook",
            "credentials": {
                "httpHeaderAuth": {
                    "id": "webhook-header-auth",
                    "name": "Webhook Header Auth"
                }
            }
        },
        {
            "parameters": {
                "jsCode": "const body = $input.first().json;\nif (!body.resume_text) throw new Error('resume_text is required');\nreturn [{ json: { resume_text: body.resume_text, candidate_email: body.candidate_email || '', session_id: `session_${Date.now()}` } }];"
            },
            "id": "validate-input",
            "name": "Validate Input",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                720,
                380
            ]
        },
        {
            "parameters": {
                "jsCode": "const d = $input.first().json;\nconst rawText = d.resume_text.substring(0, 4000);\nconst apiBody = JSON.stringify({\n  model: 'google/gemma-2-9b-it-fast',\n  messages: [\n    { role: 'system', content: 'Extract structured data from resume text. Return ONLY valid JSON: {\"personal_info\":{\"name\":\"\",\"email\":\"\",\"phone\":\"\",\"location\":\"\"},\"education\":[{\"institution\":\"\",\"level\":\"\",\"field\":\"\",\"year\":\"\"}],\"experience\":[{\"company\":\"\",\"role\":\"\",\"duration\":\"\",\"responsibilities\":[]}],\"technical_skills\":[],\"certifications\":[]}' },\n    { role: 'user', content: `Extract all information from this resume and return ONLY valid JSON:\\n\\n${rawText}` }\n  ],\n  temperature: 0.3\n});\nreturn [{ json: { ...d, api_body: apiBody } }];"
            },
            "id": "prep-extractor",
            "name": "Prep Extractor Prompt",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                940,
                380
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "https://api.studio.nebius.ai/v1/chat/completions",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "Bearer YOUR_NEBIUS_API_KEY"
                        },
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ $json.api_body }}"
            },
            "id": "extractor-api",
            "name": "Extractor API Call",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                1160,
                380
            ]
        },
        {
            "parameters": {
                "jsCode": "const resp = $input.first().json;\nconst prev = $node['Validate Input'].json;\nlet extracted = {};\ntry {\n  const raw = resp.choices[0].message.content;\n  const cleaned = raw.replace(/```json/g,'').replace(/```/g,'').trim();\n  const m = cleaned.match(/(\\{[\\s\\S]*\\})/);\n  extracted = JSON.parse(m ? m[1] : cleaned);\n} catch(e) { extracted = { error: 'parse_failed' }; }\nconst apiBody = JSON.stringify({\n  model: 'google/gemma-2-9b-it-fast',\n  messages: [\n    { role: 'system', content: 'You are an expert Career Coach AI. Analyze the extracted resume and provide actionable advice. Return ONLY JSON: {\"strengths\":[],\"skill_gaps\":[],\"cv_improvements\":[],\"career_suggestions\":[],\"overall_assessment\":\"\"}' },\n    { role: 'user', content: `Analyze this candidate profile and give career coaching advice:\\n${JSON.stringify(extracted)}\\n\\nReturn ONLY the JSON object.` }\n  ],\n  temperature: 0.5\n});\nreturn [{ json: { ...prev, extracted_profile: extracted, api_body: apiBody } }];"
            },
            "id": "parse-extractor-prep-advisor",
            "name": "Parse Extractor + Prep Advisor",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1380,
                380
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "https://api.studio.nebius.ai/v1/chat/completions",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "Bearer YOUR_NEBIUS_API_KEY"
                        },
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ $json.api_body }}"
            },
            "id": "advisor-api",
            "name": "Advisor API Call",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                1600,
                380
            ]
        },
        {
            "parameters": {
                "jsCode": "const resp = $input.first().json;\nconst prev = $node['Parse Extractor + Prep Advisor'].json;\nlet advice = {};\ntry {\n  const raw = resp.choices[0].message.content;\n  const cleaned = raw.replace(/```json/g,'').replace(/```/g,'').trim();\n  const m = cleaned.match(/(\\{[\\s\\S]*\\})/);\n  advice = JSON.parse(m ? m[1] : cleaned);\n} catch(e) { advice = { overall_assessment: 'Could not generate advice. Please retry.' }; }\nconst { api_body, ...clean } = prev;\nreturn [{ json: { ...clean, career_advice: advice, timestamp: new Date().toISOString() } }];"
            },
            "id": "parse-advisor",
            "name": "Parse Advisor Response",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1820,
                380
            ]
        },
        {
            "parameters": {
                "conditions": {
                    "options": {
                        "caseSensitive": true,
                        "leftValue": "",
                        "typeValidation": "strict"
                    },
                    "conditions": [
                        {
                            "id": "check-email-condition",
                            "leftValue": "={{ $json.candidate_email }}",
                            "rightValue": "",
                            "operator": {
                                "type": "string",
                                "operation": "notEmpty",
                                "singleValue": true
                            }
                        }
                    ],
                    "combinator": "and"
                }
            },
            "id": "check-email",
            "name": "Has Email?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 2,
            "position": [
                2040,
                380
            ]
        },
        {
            "parameters": {
                "jsCode": "const d = $input.first().json;\nconst esc = v => String(v ?? '').replace(/[&<>\"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nconst name = esc(d.extracted_profile?.personal_info?.name || 'Candidate');\nconst advice = d.career_advice || {};\nconst strengths = (advice.strengths || []).map(s => `<li>${esc(s)}</li>`).join('');\nconst gaps = (advice.skill_gaps || []).map(g => `<li>${esc(g)}</li>`).join('');\nconst improvements = (advice.cv_improvements || []).map(i => `<li>${esc(i)}</li>`).join('');\nconst suggestions = (advice.career_suggestions || []).map(c => `<li>${esc(c)}</li>`).join('');\nreturn [{ json: { ...d,\n  email_subject: `Your AI Career Assessment is Ready, ${name}!`.replace(/[\\r\\n]+/g, ' '),\n  email_html: `<h2>Your AI Career Assessment 🎯</h2><p>Hi ${name},</p><p><strong>Overall Assessment:</strong> ${esc(advice.overall_assessment)}</p><h3>✅ Key Strengths</h3><ul>${strengths}</ul><h3>📈 Skill Gaps</h3><ul>${gaps}</ul><h3>📝 CV Improvements</h3><ul>${improvements}</ul><h3>🚀 Career Paths</h3><ul>${suggestions}</ul>`\n} }];"
            },
            "id": "build-email",
            "name": "Build Email HTML",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                2260,
                260
            ]
        },
        {
            "parameters": {
                "fromEmail": "recruiter@example.com",
                "toEmail": "={{ $json.candidate_email }}",
                "subject": "={{ $json.email_subject }}",
                "emailType": "html",
                "message": "={{ $json.email_html }}"
            },
            "id": "send-email",
            "name": "Send Assessment Email",
            "type": "n8n-nodes-base.emailSend",
            "typeVersion": 2.1,
            "position": [
                2480,
                260
            ],
            "credentials": {
                "smtp": {
                    "id": "smtp-creds",
                    "name": "SMTP"
                }
            },
            "disabled": true
        },
        {
            "parameters": {
                "respondWith": "json",
                "responseBody": "={{ JSON.stringify($json, null, 2) }}"
            },
            "id": "respond",
            "name": "Return Assessment",
            "type": "n8n-nodes-base.respondToWebhook",
            "typeVersion": 1.1,
            "position": [
                2260,
                520
            ]
        }
    ],
    "connections": {
        "Candidate Advisor Webhook": {
